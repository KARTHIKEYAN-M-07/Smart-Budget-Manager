# ==============================================================================
# Smart Family Budget Manager - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and replace placeholder values.
# NEVER commit .env to version control.
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=false
APP_NAME="Smart Family Budget Manager"
APP_VERSION=0.1.0

# Server Binding
HOST=0.0.0.0
PORT=8000

# Security & Secrets (Generate strong 256-bit random keys in production)
# Example: openssl rand -hex 32
SECRET_KEY=change-this-in-production-to-a-secure-random-32-byte-hex-key
FIELD_ENCRYPTION_KEY=change-this-32-byte-aes-key-for-credentials-encryption-example

# Session Configuration
SESSION_COOKIE_NAME=sfbm_session
SESSION_EXPIRE_SECONDS=604800
SESSION_IDLE_TIMEOUT_SECONDS=7200
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# Database Configuration (PostgreSQL 16)
POSTGRES_USER=budget_user
POSTGRES_PASSWORD=budget_secure_password
POSTGRES_DB=family_budget_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://budget_user:budget_secure_password@postgres:5432/family_budget_db
DATABASE_SYNC_URL=postgresql+psycopg2://budget_user:budget_secure_password@postgres:5432/family_budget_db

# CORS Configuration (Comma-separated list of allowed origins)
ALLOWED_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Localization & Financial Defaults
DEFAULT_CURRENCY=INR
DEFAULT_TIMEZONE=Asia/Kolkata
